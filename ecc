    exit 1
  fi

  local action="${1:-report}"
  case "$action" in
    rules|--rules|-r)
      python3 -c "
import sys
sys.path.insert(0, '$(dirname "$server_script")')
import server
print(server.tool_sentinel_get_rules({}))
"
      ;;
    violations|--violations|-v)
      python3 -c "
import sys
sys.path.insert(0, '$(dirname "$server_script")')
import server
print(server.tool_sentinel_verify_compliance({}))
"
      ;;
    report|--report|*)
      python3 -c "
import sys
sys.path.insert(0, '$(dirname "$server_script")')
import server
print(server.tool_sentinel_get_compliance_report({}))
"
      ;;
  esac
}

# ─── Live Tester (Real-Time Testing Engine) ───

cmd_test() {
  local server_script
  if ! server_script=$(find_mcp_server "swarm-tester"); then
    issue "swarm-tester server script not found"
    exit 1
  fi

  local action="${1:-suite}"
  case "$action" in
    --watch|-w|watch)
      echo -e "${C_CYAN}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
      echo -e "${C_CYAN}${C_BOLD}  ecc test --watch — Continuous Live Verification Loop   ${C_NC}"
      echo -e "${C_CYAN}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
      echo "Monitoring project changes every 3s. Press Ctrl+C to stop."
      echo ""
      python3 -c "
import sys, time, json
sys.path.insert(0, '$(dirname "$server_script")')
import server

while True:
    try:
        report = server.tool_tester_quick_check({})
        health = report.get('health', 'UNKNOWN')
        mod_count = len(report.get('modified_files', []))
        passed = report.get('passed', True)
        color = '\033[32m' if passed else '\033[31m'
        print(f'\r\033[K[Live Tester] Health: {color}{health}\033[0m | Changed: {mod_count} files | Passed: {passed}', end='', flush=True)
        if not passed:
            print('\n' + json.dumps(report, indent=2))
        time.sleep(3)
    except KeyboardInterrupt:
        print('\nStopped live watch.')
        break
    except Exception as e:
        print(f'\nError in live tester: {e}')
        time.sleep(3)
"
      ;;
    --probe|-p|probe)
      local target_url="${2:-http://localhost:8000/health}"
      python3 -c "
import sys
sys.path.insert(0, '$(dirname "$server_script")')
import server
print(server.tool_tester_probe_endpoint({'url': '$target_url'}))
"
      ;;
    --component|-c|component)
      local comp_path="${2:-}"
      if [ -z "$comp_path" ]; then
        issue "Please specify component file path: ecc test --component <path>"
        exit 1
      fi
      python3 -c "
import sys
sys.path.insert(0, '$(dirname "$server_script")')
import server
print(server.tool_tester_verify_component({'file_path': '$comp_path'}))
"
      ;;
    --health|health)
      python3 -c "
import sys
sys.path.insert(0, '$(dirname "$server_script")')
import server
print(server.tool_tester_get_live_health({}))
"
      ;;
    --sync|sync)
      python3 -c "
import sys
sys.path.insert(0, '$(dirname "$server_script")')
import server
print(server.tool_tester_sync_with_sentinel({}))
"
      ;;
    suite|--suite|*)
      local target=""
      local runner="auto"
      if [ "$action" = "suite" ] || [ "$action" = "--suite" ]; then
        target="${2:-}"
      elif [ -n "$action" ]; then
        target="$action"
      fi

      case "$target" in
        pytest|unittest|vitest|jest|cargo|go|npm|bun)
          runner="$target"
          target=""
          ;;
      esac

      python3 -c "
import sys, json
sys.path.insert(0, '$(dirname "$server_script")')
import server
res = server.tool_tester_run_suite({'path': '$target', 'runner': '$runner', 'auto_sync_sentinel': True})
if isinstance(res, str):
    print(res)
else:
    print(json.dumps(res, indent=2))
"
      ;;
  esac
}

# ─── Validate ───

cmd_validate() {
  echo -e "${C_CYAN}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
  echo -e "${C_CYAN}${C_BOLD}  ecc validate — Integrity Verification${C_NC}"
  echo -e "${C_CYAN}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
  echo ""
  local errors=0

  # Check required config files
  if [ -f "$ECC_CONFIG/opencode.jsonc" ]; then
    log "  ✓ opencode.jsonc"
  elif [ -f "$ECC_CONFIG/opencode.json" ]; then
    log "  ✓ opencode.json"
  else
    issue "  ✗ opencode.jsonc or opencode.json (missing)"
    errors=$((errors + 1))
  fi

  for f in "$ECC_CONFIG/INSTRUCTIONS.md" "$ECC_CONFIG/AGENTS.md"; do
    if [ -f "$f" ]; then
      log "  ✓ $(basename "$f")"
    else
      issue "  ✗ $f (missing)"
      errors=$((errors + 1))
    fi
  done

  # Validate JSON files
  for jf in "$ECC_CONFIG/opencode.json" "$ECC_CONFIG/tui.json"; do
    if [ -f "$jf" ]; then
      if python3 -c "import json; json.load(open('$jf'))" 2>/dev/null; then
        log "  ✓ $(basename "$jf") (valid JSON)"
      else
        issue "  ✗ $(basename "$jf") (invalid JSON syntax)"
        errors=$((errors + 1))
      fi
    fi
  done

  # Validate JSONC
  if [ -f "$ECC_CONFIG/opencode.jsonc" ]; then
    local py_script
    py_script=$(mktemp)
    cat >"$py_script" <<'PYEOF'
import json, sys
def strip_jsonc(content):
    res, i, in_str, esc = [], 0, False, False
    while i < len(content):
        c = content[i]
        if c == '"' and not esc:
            in_str = not in_str
            res.append(c)
        elif c == '\\' and not esc and in_str:
            esc = True
            res.append(c)
        elif c == '/' and i + 1 < len(content) and content[i+1] == '/' and not in_str:
            while i < len(content) and content[i] != '\n':
                i += 1
            continue
        elif c == '/' and i + 1 < len(content) and content[i+1] == '*' and not in_str:
            i += 2
            while i + 1 < len(content):
                if content[i] == '*' and content[i+1] == '/':
                    i += 2
                    break
                i += 1
            continue
        else:
            res.append(c)
            if esc: esc = False
        i += 1
    return ''.join(res)
with open(sys.argv[1]) as f:
    json.loads(strip_jsonc(f.read()))
PYEOF
    if python3 "$py_script" "$ECC_CONFIG/opencode.jsonc" 2>/dev/null; then
      log "  ✓ opencode.jsonc (valid JSONC)"
    else
      issue "  ✗ opencode.jsonc (invalid syntax)"
      errors=$((errors + 1))
    fi
    rm -f "$py_script"
  fi

  # Validate Agents
  if [ -d "$ECC_CONFIG/agents" ]; then
    for af in "$ECC_CONFIG/agents"/*.md; do
      [ -f "$af" ] || continue
      if grep -q "^description:" "$af" && grep -q "^mode:" "$af"; then
        log "  ✓ agent: $(basename "$af" .md) (valid frontmatter)"
      else
        warn "  ✗ agent: $(basename "$af" .md) (missing frontmatter fields)"
        errors=$((errors + 1))
      fi
    done
  fi

  # Validate MCP server syntax
  for ms in "$ECC_CONFIG/mcp/context-memory/server.py" "$ECC_CONFIG/mcp/team-collab/server.py" "$ECC_CONFIG/mcp/swarm-sentinel/server.py" "$ECC_CONFIG/mcp/swarm-tester/server.py"; do
    if [ -f "$ms" ]; then
      if python3 -m py_compile "$ms" 2>/dev/null; then
        log "  ✓ $(basename "$(dirname "$ms")")/server.py (compiled cleanly)"
      else
        issue "  ✗ $(basename "$(dirname "$ms")")/server.py (python syntax error)"
        errors=$((errors + 1))
      fi
    fi
  done

  echo ""
  if [ "$errors" -eq 0 ]; then
    echo -e "${C_GREEN}${C_BOLD}✓ All Swarm files validated successfully!${C_NC}"
  else
    echo -e "${C_RED}${C_BOLD}✗ $errors error(s) found${C_NC}"
  fi
}

# ─── Configure ───

cmd_configure() {
  if [ -f "$ECC_CONFIG/scripts/configure.sh" ]; then
    exec "$ECC_CONFIG/scripts/configure.sh" "$@"
  else
    issue "Configuration script not found in $ECC_CONFIG/scripts/"
    exit 1
  fi
}

# ─── Update ───

cmd_update() {
  echo -e "${C_CYAN}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
  echo -e "${C_CYAN}${C_BOLD}  ecc update — Pull Latest Swarm Version${C_NC}"
  echo -e "${C_CYAN}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
  echo ""

  local repo_dir
  if [ -d "$ECC_ROOT/repo" ]; then
    repo_dir="$ECC_ROOT/repo"
  elif git rev-parse --show-toplevel 2>/dev/null; then
    repo_dir=$(git rev-parse --show-toplevel 2>/dev/null || true)
  fi

  if [ -n "${repo_dir:-}" ] && [ -d "${repo_dir:-}/.git" ]; then
    echo "  Repository: $repo_dir"
    (cd "$repo_dir" && git pull) && log "Repository updated" || {
      issue "Failed to pull latest changes"
      exit 1
    }
    echo ""
    info "Re-applying Swarm configuration..."
    (cd "$repo_dir" && exec ./install.sh)
  else
    warn "Repository not found locally"
    echo ""
    echo "  To update manually:"
    echo "    git clone https://github.com/anthra123x/opencode_config.git"
    echo "    cd opencode_config && ./install.sh"
  fi
}

# ─── Uninstall ───

cmd_uninstall() {
  echo -e "${C_RED}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
  echo -e "${C_RED}${C_BOLD}  ecc uninstall — Remove Swarm Configuration${C_NC}"
  echo -e "${C_RED}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
  echo ""
  echo -e "${C_RED}This will remove:${C_NC}"
  echo "    $ECC_CONFIG"
  echo "    $ECC_SKILLS"
  echo "    $HOME/.local/bin/ecc"
  echo "    $HOME/.local/bin/opencode-context-memory"
  echo "    $HOME/.local/bin/opencode-team-collab"
  echo "    $HOME/.local/bin/opencode-swarm-sentinel"
  echo "    $HOME/.local/bin/opencode-swarm-tester"
  echo ""

  local answer
  read -rp "Are you sure? Type 'yes' to confirm: " answer
  if [ "$answer" != "yes" ]; then
    echo "Cancelled."
    exit 0
  fi

  if [ -d "$ECC_CONFIG" ]; then
    local bk; bk=$(backup_dir "$ECC_CONFIG")
    info "Config backed up: $bk"
  fi

  rm -rf "$ECC_CONFIG" && log "Removed config: $ECC_CONFIG" || warn "Failed to remove config"
  rm -rf "$ECC_SKILLS" && log "Removed skills: $ECC_SKILLS" || warn "Failed to remove skills"
  rm -f "$HOME/.local/bin/ecc" "$HOME/.local/bin/opencode-context-memory" "$HOME/.local/bin/opencode-team-collab" "$HOME/.local/bin/opencode-swarm-sentinel" "$HOME/.local/bin/opencode-swarm-tester" 2>/dev/null || true

  echo ""
  log "Uninstall complete. Backups saved alongside original locations."
}

# ─── Main dispatch ───

main() {
  case "${1:-help}" in
    doctor|check)
      cmd_doctor
      ;;
    status|info)
      cmd_status
      ;;
    live|watch|activity)
      cmd_live "${@:2}"
      ;;
    team|board|tasks)
      cmd_team
      ;;
    memory|recall|ctx)
      cmd_memory "${@:2}"
      ;;
    sentinel|audit|guard|compliance)
      cmd_sentinel "${@:2}"
      ;;
    test|testing|suite)
      cmd_test "${@:2}"
      ;;
    validate|verify)
      cmd_validate
      ;;
    configure|config|setup)
      cmd_configure "${@:2}"
      ;;
    update|upgrade)
      cmd_update
      ;;
    uninstall|remove)
      cmd_uninstall
      ;;
    help|--help|-h|"")
      show_help
      ;;
    *)
      echo "ecc: unknown command '$1'"
      echo "Run 'ecc help' for usage"
      exit 1
      ;;
  esac
}

main "$@"
