#!/usr/bin/env bash
set -euo pipefail

# ecc — OpenCode Swarm Configuration Manager CLI
# Installed to ~/.local/bin/ecc by install.sh

ECC_CONFIG="${ECC_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/opencode}"
if [ -d "$ECC_CONFIG/skills" ]; then
  ECC_SKILLS="${ECC_SKILLS:-$ECC_CONFIG/skills}"
else
  ECC_SKILLS="${ECC_SKILLS:-$HOME/.opencode/skills}"
fi
ECC_ROOT="${ECC_ROOT:-$HOME/.local/share/opencode}"
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

find_mcp_server() {
  local name="$1"
  local candidates=(
    "$ECC_CONFIG/mcp/$name/server.py"
    "$ECC_CONFIG/swarm/mcp/$name/server.py"
    "$HOME/.config/opencode/swarm/mcp/$name/server.py"
    "$REPO_DIR/mcp/$name/server.py"
  )
  for p in "${candidates[@]}"; do
    if [ -f "$p" ]; then
      echo "$p"
      return 0
    fi
  done
  return 1
}

# Source installed libraries
if [ -f "$ECC_CONFIG/lib/ui.sh" ]; then
  source "$ECC_CONFIG/lib/ui.sh"
  setup_ui
fi
if [ -f "$ECC_CONFIG/lib/paths.sh" ]; then
  source "$ECC_CONFIG/lib/paths.sh"
  setup_paths
fi
if [ -f "$ECC_CONFIG/lib/utils.sh" ]; then
  source "$ECC_CONFIG/lib/utils.sh"
  setup_utils
fi

# Fallback UI colors if not sourced
C_CYAN="${C_CYAN:-\033[36m}"
C_GREEN="${C_GREEN:-\033[32m}"
C_YELLOW="${C_YELLOW:-\033[33m}"
C_RED="${C_RED:-\033[31m}"
C_MAGENTA="${C_MAGENTA:-\033[35m}"
C_BLUE="${C_BLUE:-\033[34m}"
C_BOLD="${C_BOLD:-\033[1m}"
C_DIM="${C_DIM:-\033[2m}"
C_NC="${C_NC:-\033[0m}"

log()   { echo -e "${C_GREEN}✓${C_NC} $1"; }
info()  { echo -e "${C_CYAN}→${C_NC} $1"; }
warn()  { echo -e "${C_YELLOW}⚠${C_NC} $1"; }
issue() { echo -e "${C_RED}✗${C_NC} $1"; }

in_path() {
  local dir="${1:-$HOME/.local/bin}"
  case ":$PATH:" in
    *:"$dir":*) return 0 ;;
    *) return 1 ;;
  esac
}

show_help() {
  cat <<EOF
Usage: ecc <command> [options]

Commands:
  doctor      Run comprehensive diagnostic checks on the Swarm installation
  status      Show installation overview, agents roster, and MCP status
  live        Real-time multi-window swarm monitor (use --watch for auto-refresh)
  team        Display real-time multi-agent team board and active tasks
  test        Real-time test suite runner, endpoint probing, and component check
  memory      Query persistent context memory (e.g. 'ecc memory auth' or 'ecc memory')
  sentinel    Inspect development rules, violations, and compliance reports
  validate    Verify integrity of JSON, JSONC, agent definitions, and skills
  configure   Re-run the interactive configuration wizard
  update      Pull latest version from git repository and re-apply
  uninstall   Remove all installed files (with automatic backup)
  help        Show this help message

Examples:
  ecc doctor
  ecc live --watch
  ecc test
  ecc test --watch
  ecc test --probe http://localhost:8000/health
  ecc team
  ecc sentinel --rules
  ecc memory "database conventions"
  ecc validate

Report issues: https://github.com/anthra123x/opencode_config
EOF
}

# ─── Doctor ───

cmd_doctor() {
  echo -e "${C_CYAN}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
  echo -e "${C_CYAN}${C_BOLD}  ecc doctor — Swarm System Diagnostic${C_NC}"
  echo -e "${C_CYAN}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
  echo ""
  local issues=0

  # opencode CLI
  if command -v opencode &>/dev/null; then
    log "OpenCode CLI: $(command -v opencode) ($(opencode --version 2>/dev/null || echo 'active'))"
  elif command -v claude &>/dev/null; then
    log "Claude Code CLI: $(command -v claude)"
  else
    issue "No opencode or claude CLI found in PATH"
    issues=$((issues + 1))
  fi

  # Python 3 & SQLite FTS5
  if command -v python3 &>/dev/null; then
    if python3 -c "import sqlite3; conn = sqlite3.connect(':memory:'); conn.execute('CREATE VIRTUAL TABLE t USING fts5(c)')" &>/dev/null; then
      log "Python 3 with SQLite FTS5: $(python3 --version 2>&1)"
    else
      warn "Python 3 found but SQLite FTS5 extension missing (context-memory may use LIKE fallback)"
    fi
  else
    issue "Python 3 not found in PATH (required for native MCP servers)"
    issues=$((issues + 1))
  fi

  # Config directory & core files
  if [ -d "$ECC_CONFIG" ]; then
    log "Config directory: $ECC_CONFIG"
    if [ -f "$ECC_CONFIG/opencode.jsonc" ]; then
      log "  ✓ opencode.jsonc"
    elif [ -f "$ECC_CONFIG/opencode.json" ]; then
      log "  ✓ opencode.json"
    else
      warn "  ✗ opencode.jsonc (missing)"
      issues=$((issues + 1))
    fi
    for f in INSTRUCTIONS.md AGENTS.md; do
      if [ -f "$ECC_CONFIG/$f" ]; then
        log "  ✓ $f"
      else
        warn "  ✗ $f (missing)"
        issues=$((issues + 1))
      fi
    done
  else
    issue "Config directory not found: $ECC_CONFIG"
    issues=$((issues + 1))
  fi

  # Specialized Sub-Agents
  if [ -d "$ECC_CONFIG/agents" ]; then
    local acount; acount=$(find "$ECC_CONFIG/agents" -maxdepth 1 -name "*.md" 2>/dev/null | wc -l)
    log "Specialized Agents: $acount agent(s) installed"
    for a in "$ECC_CONFIG/agents"/*.md; do
      [ -f "$a" ] || continue
      log "  ✓ @$(basename "$a" .md)"
    done
  else
    warn "Agents directory not found: $ECC_CONFIG/agents"
    issues=$((issues + 1))
  fi

  # Native MCP Servers
  for mcp_name in context-memory team-collab swarm-sentinel swarm-tester; do
    local s_script
    if s_script=$(find_mcp_server "$mcp_name"); then
      log "MCP Server [$mcp_name]: $s_script"
    else
      warn "MCP Server [$mcp_name] missing"
      issues=$((issues + 1))
    fi
  done

  # Skills
  if [ -d "$ECC_SKILLS" ]; then
    local scount; scount=$(find "$ECC_SKILLS" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
    log "Skills directory: $ECC_SKILLS ($scount skills)"
  else
    warn "Skills directory not found: $ECC_SKILLS"
    issues=$((issues + 1))
  fi

  # PATH check
  local bindir="${HOME}/.local/bin"
  if in_path "$bindir"; then
    log "\$PATH includes $bindir"
  else
    warn "\$PATH does not include $bindir — add it to your ~/.bashrc or ~/.zshrc"
    issues=$((issues + 1))
  fi

  # bash version
  if [[ ${BASH_VERSINFO[0]} -ge 4 ]]; then
    log "bash: ${BASH_VERSION}"
  else
    warn "bash 4+ required (found ${BASH_VERSINFO[0]})"
    issues=$((issues + 1))
  fi

  echo ""
  if [ "$issues" -eq 0 ]; then
    echo -e "${C_GREEN}${C_BOLD}✓ All Swarm checks passed successfully!${C_NC}"
  else
    echo -e "${C_YELLOW}${C_BOLD}⚠ $issues issue(s) detected${C_NC}"
    echo "  Run 'ecc validate' for file-level integrity checks"
  fi
}

# ─── Status ───

cmd_status() {
  echo -e "${C_CYAN}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
  echo -e "${C_CYAN}${C_BOLD}  ecc status — Swarm Installation Overview${C_NC}"
  echo -e "${C_CYAN}${C_BOLD}══════════════════════════════════════════════════════════${C_NC}"
  echo ""

  # Configuration
  echo -e "  ${C_BOLD}Configuration:${C_NC}"
  if [ -d "$ECC_CONFIG" ]; then
    local csize; csize=$(du -sh "$ECC_CONFIG" 2>/dev/null | cut -f1)
    echo "    Path:   $ECC_CONFIG"
    echo "    Size:   ${csize:-unknown}"
    local theme_name="default"
    if [ -f "$ECC_CONFIG/tui.json" ]; then
      theme_name=$(python3 -c "import json; print(json.load(open('$ECC_CONFIG/tui.json')).get('theme', 'default'))" 2>/dev/null || echo "tokyonight")
    fi
    echo -e "    Theme:  ${C_MAGENTA}$theme_name${C_NC}"
  else
    warn "    Not installed"
  fi

  # Agents Roster
  echo ""
  echo -e "  ${C_BOLD}Specialized Agents Roster:${C_NC}"
  if [ -d "$ECC_CONFIG/agents" ]; then
    for f in "$ECC_CONFIG/agents"/*.md; do
      [ -f "$f" ] || continue
      local aname; aname=$(basename "$f" .md)
      local desc; desc=$(grep -m 1 "^description:" "$f" 2>/dev/null | sed 's/^description: *//' || echo "")
      if [ "$aname" = "orchestrator" ]; then
        echo -e "    ${C_MAGENTA}• @$aname${C_NC} (primary): $desc"
      elif [ "$aname" = "backend" ]; then
        echo -e "    ${C_BLUE}• @$aname${C_NC} (subagent): $desc"
      elif [ "$aname" = "frontend" ]; then
        echo -e "    ${C_RED}• @$aname${C_NC} (subagent): $desc"
      elif [ "$aname" = "git-flow" ]; then
        echo -e "    ${C_GREEN}• @$aname${C_NC} (subagent): $desc"
      elif [ "$aname" = "qa-auditor" ]; then
        echo -e "    ${C_YELLOW}• @$aname${C_NC} (subagent): $desc"
      elif [ "$aname" = "devops" ]; then
        echo -e "    ${C_CYAN}• @$aname${C_NC} (subagent): $desc"
      else
        echo -e "    • @$aname (subagent): $desc"
      fi
    done
  else
    warn "    No agents installed"
  fi

  # MCP Servers & Storage
  echo ""
  echo -e "  ${C_BOLD}Native MCP Servers & Storage:${C_NC}"
  local mem_db="${OPENCODE_MEMORY_DB:-$HOME/.opencode/memory/context_memory.db}"
  local team_db="${OPENCODE_TEAM_DB:-$HOME/.opencode/team/team_collab.db}"

  if [ -f "$mem_db" ]; then
    local mcount; mcount=$(python3 -c "import sqlite3; conn=sqlite3.connect('$mem_db'); print(conn.execute('SELECT COUNT(*) FROM memories').fetchone()[0])" 2>/dev/null || echo "0")
    local msize; msize=$(du -sh "$mem_db" 2>/dev/null | cut -f1)
    echo -e "    ${C_GREEN}✓${C_NC} context-memory (FTS5): $mcount memory item(s) stored ($msize)"
  else
    echo -e "    ${C_GREEN}✓${C_NC} context-memory (ready, database will initialize on first use)"
  fi

  if [ -f "$team_db" ]; then
    local tcount; tcount=$(python3 -c "import sqlite3; conn=sqlite3.connect('$team_db'); print(conn.execute('SELECT COUNT(*) FROM team_tasks').fetchone()[0])" 2>/dev/null || echo "0")
    echo -e "    ${C_GREEN}✓${C_NC} team-collab (Swarm Bus): $tcount task(s) on board"
  else
    echo -e "    ${C_GREEN}✓${C_NC} team-collab (ready, database will initialize on first use)"
  fi

  local sentinel_db="${OPENCODE_SENTINEL_DB:-$HOME/.opencode/sentinel/sentinel.db}"
  if [ -f "$sentinel_db" ]; then
    local rcount; rcount=$(python3 -c "import sqlite3; conn=sqlite3.connect('$sentinel_db'); print(conn.execute('SELECT COUNT(*) FROM sentinel_rules WHERE enabled=1').fetchone()[0])" 2>/dev/null || echo "7")
    local vcount; vcount=$(python3 -c "import sqlite3; conn=sqlite3.connect('$sentinel_db'); print(conn.execute('SELECT COUNT(*) FROM sentinel_violations WHERE resolved=0').fetchone()[0])" 2>/dev/null || echo "0")
    echo -e "    ${C_GREEN}✓${C_NC} swarm-sentinel (Rules & Audit): $rcount active rule(s), $vcount open violation(s)"
  else
    echo -e "    ${C_GREEN}✓${C_NC} swarm-sentinel (ready, 7 engineering rules active)"
  fi

  local tester_db="${OPENCODE_TESTER_DB:-$HOME/.opencode/tester/tester.db}"
  if [ -f "$tester_db" ]; then
    local run_count; run_count=$(python3 -c "import sqlite3; conn=sqlite3.connect('$tester_db'); print(conn.execute('SELECT COUNT(*) FROM tester_runs').fetchone()[0])" 2>/dev/null || echo "0")
    local comp_count; comp_count=$(python3 -c "import sqlite3; conn=sqlite3.connect('$tester_db'); print(conn.execute('SELECT COUNT(*) FROM component_checks').fetchone()[0])" 2>/dev/null || echo "0")
    echo -e "    ${C_GREEN}✓${C_NC} swarm-tester (Live Testing & Probes): $run_count test run(s), $comp_count component check(s)"
  else
    echo -e "    ${C_GREEN}✓${C_NC} swarm-tester (ready, continuous automated testing engine)"
  fi

  # Skills
  echo ""
  echo -e "  ${C_BOLD}Skills Library:${C_NC}"
  if [ -d "$ECC_SKILLS" ]; then
    local scount; scount=$(find "$ECC_SKILLS" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
    echo "    Installed: $scount skills in $ECC_SKILLS"
  else
    warn "    Not installed"
  fi
}

# ─── Team Board ───

cmd_team() {
  local server_script
  if ! server_script=$(find_mcp_server "team-collab"); then
    issue "team-collab server script not found"
    exit 1
  fi

  python3 -c "
import sys
sys.path.insert(0, '$(dirname "$server_script")')
import server
print(server.tool_team_get_status({}))
"
}

# ─── Live Swarm Activity Monitor ───

cmd_live() {
  local server_script
  if ! server_script=$(find_mcp_server "team-collab"); then
    issue "team-collab server script not found"
    exit 1
  fi

  local watch_mode=false
  for arg in "$@"; do
    if [ "$arg" = "--watch" ] || [ "$arg" = "-w" ]; then
      watch_mode=true
    fi
  done

  if [ "$watch_mode" = true ]; then
    echo -e "${C_CYAN}Starting real-time Swarm monitor (press Ctrl+C to exit)...${C_NC}"
    trap "echo -e '\n${C_NC}Monitor stopped.'; exit 0" INT
    while true; do
      clear
      python3 -c "
import sys
sys.path.insert(0, '$(dirname "$server_script")')
import server
print(server.tool_team_get_live_activity({}))
"
      sleep 2
    done
  else
    python3 -c "
import sys
sys.path.insert(0, '$(dirname "$server_script")')
import server
print(server.tool_team_get_live_activity({}))
"
  fi
}


# ─── Memory Inspector ───

cmd_memory() {
  local server_script
  if ! server_script=$(find_mcp_server "context-memory"); then
    issue "context-memory server script not found"
