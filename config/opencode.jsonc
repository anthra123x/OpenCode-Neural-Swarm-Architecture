{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "instructions": [
    "SWARM.md",
    "INSTRUCTIONS.md",
    "AGENTS.md"
  ],
  "skills": {
    "paths": [
      "~/.opencode/skills"
    ]
  },
  "mcp": {
    "brain-graph": {
      "type": "local",
      "command": ["opencode-brain-graph"],
      "enabled": true
    },
    "swarm-engine": {
      "type": "local",
      "command": ["opencode-swarm-engine"],
      "enabled": true
    },
    "context-memory": {
      "type": "local",
      "command": ["opencode-context-memory"],
      "enabled": false
    },
    "team-collab": {
      "type": "local",
      "command": ["opencode-team-collab"],
      "enabled": false
    },
    "swarm-sentinel": {
      "type": "local",
      "command": ["opencode-swarm-sentinel"],
      "enabled": false
    },
    "swarm-tester": {
      "type": "local",
      "command": ["opencode-swarm-tester"],
      "enabled": false
    },
    "codebase-memory-mcp": {
      "type": "local",
      "command": ["codebase-memory-mcp"],
      "enabled": false
    }
  },
  "agent": {
    "orchestrator": {
      "mode": "primary",
      "color": "#8B5CF6",
      "steps": 80,
      "description": "[Lead Architect] Orchestrator & System Designer. Coordinates autonomous subagents and MCP workflows."
    },
    "backend": {
      "mode": "all",
      "color": "#3B82F6",
      "steps": 80,
      "description": "[Backend Specialist] APIs, Database Models (Postgres/Prisma/MySQL) & TDD Unit Testing (>=80%)."
    },
    "frontend": {
      "mode": "all",
      "color": "#EC4899",
      "steps": 80,
      "description": "[Frontend Specialist] Modern UI/UX, Component Ergonomics, Tokens & Anti-Slop Design."
    },
    "git-flow": {
      "mode": "all",
      "color": "#10B981",
      "steps": 30,
      "description": "[GitFlow Manager] Branch Lifecycles, Conventional Commits 1.0 & Clean Releases."
    },
    "qa-auditor": {
      "mode": "all",
      "color": "#F59E0B",
      "steps": 80,
      "description": "[QA & Sentinel Auditor] 6-Stage Verification Loop, Live Tester & Defensive Rule Audits."
    },
    "devops": {
      "mode": "all",
      "color": "#06B6D4",
      "steps": 50,
      "description": "[DevOps Specialist] Multi-Stage Dockerfiles, Rootless Containers & CI/CD Pipelines."
    }
  },
  "experimental": {
    "subagent_depth": 5
  },
  "permission": {
    "skill": {
      "*": "allow"
    },
    "tool": {
      "subagent": "allow"
    }
  },
  "compaction": {
    "auto": false,
    "tail_turns": 80
  }
}
